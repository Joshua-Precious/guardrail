collection admins {
  hideFromApi: true;
  auth: true;

  fields: {
    name: text;
    email: email @unique;
    password: password;
    role: select("admin", "super", "editor") @default("admin");
    avatar: text @optional;
  }

  access: {
    read: user.role == "admin" || user.role == "super";
    create: user.role == "admin" || user.role == "super";
    update: user.id == id || user.role == "admin" || user.role == "super";
    delete: user.role == "admin" || user.role == "super";
  }
}
