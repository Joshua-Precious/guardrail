{
  "name": "guardrail",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "build": "bun build cequre/index.ts --outdir dist --target bun",
    "dev": "cequre dev -e cequre/index.ts",
    "start": "NODE_ENV=production bun run dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "seed": "bun run scripts/seed.ts",
    "acceptance": "bun run scripts/acceptance.ts",
    "agent": "bun run agent/index.ts",
    "model:check": "bun run scripts/model-check.ts",
    "executor": "bun run executor/index.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "latest"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
