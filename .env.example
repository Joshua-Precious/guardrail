
JWT_SECRET=change-me
DATABASE_URL=postgresql://user:password@localhost:5432/guardrail
CEQURE_ENCRYPTION_KEY=#   cequre key:generate --save

# ─── monitoring plugin (optional) ────────────────────────────────────────────
MONITORING_API_KEY=change-me
OTEL_ENDPOINT=http://localhost:4318/v1/logs
MONITORING_WEBHOOK_URL=
MONITORING_WEBHOOK_URL_2=

# ─── demo accounts (see lib/app.ts, scripts/seed.ts) ─────────────────────────
API_BASE_URL=http://localhost
ADMIN_EMAIL=admin@guardrail.dev
ADMIN_PASSWORD=Passw0rd!123
AGENT_EMAIL=agent@guardrail.dev
AGENT_PASSWORD=Passw0rd!123
EXECUTOR_EMAIL=executor@guardrail.dev
EXECUTOR_PASSWORD=Passw0rd!123
CUSTOMER_EMAIL=john.doe@example.com
POLL_INTERVAL_MS=3000

# ─── agent model provider (provider-neutral) ─────────────────────────────────
# scripted (deterministic, no network — the default) | openai-compatible | anthropic
#
# Ollama Cloud (no local server needed):
#   AI_PROVIDER=openai-compatible
#   AI_BASE_URL=https://ollama.com/v1
#   AI_MODEL=gpt-oss:120b
#   AI_API_KEY=<your ollama.com API key>
#
# Local Ollama:
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_MODEL=gpt-oss:20b
#   AI_API_KEY=ollama          # the value is ignored, but the client requires one
AI_PROVIDER=scripted
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
